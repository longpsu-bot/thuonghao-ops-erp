{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:atlas:shopping-list:xlsx:v1",
  "title": "Atlas Shopping List V1 normalized workbook evidence",
  "$comment": "Design-only closed object shapes and physical annotations. Cross-object invariants below require a separate validator; this is not an XLSX ZIP, currentness, backend-authority, or import implementation validator.",
  "type": "object",
  "additionalProperties": false,
  "required": ["metadata", "rows"],
  "properties": {
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_name",
        "contract_version",
        "workbook_marker",
        "exported_at",
        "service_period_start",
        "service_period_end",
        "confirmed_need_batch_id",
        "batch_version",
        "need_generation_run_id",
        "release_snapshot_id"
      ],
      "properties": {
        "contract_name": {
          "const": "ATLAS_SHOPPING_LIST"
        },
        "contract_version": {
          "const": "ATLAS_SHOPPING_LIST_V1"
        },
        "workbook_marker": {
          "$ref": "#/$defs/uuid"
        },
        "exported_at": {
          "type": "string",
          "format": "date-time"
        },
        "service_period_start": {
          "type": "string",
          "format": "date"
        },
        "service_period_end": {
          "type": "string",
          "format": "date"
        },
        "confirmed_need_batch_id": {
          "$ref": "#/$defs/uuid"
        },
        "batch_version": {
          "type": "integer",
          "minimum": 1
        },
        "need_generation_run_id": {
          "$ref": "#/$defs/uuid"
        },
        "release_snapshot_id": {
          "$ref": "#/$defs/uuid"
        }
      }
    },
    "rows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "school_display",
          "ingredient_name",
          "unit_code",
          "quantity",
          "note",
          "__workbook_marker",
          "__line_id",
          "__revision_id",
          "__decision_id",
          "__service_date",
          "__school_id",
          "__location_id",
          "__ingredient_id",
          "__unit_id",
          "__exported_quantity",
          "__exported_reason_code",
          "__exported_note"
        ],
        "properties": {
          "ingredient_name": {
            "type": "string",
            "minLength": 1
          },
          "unit_code": {
            "type": "string",
            "minLength": 1
          },
          "quantity": {
            "$ref": "#/$defs/decimal"
          },
          "note": {
            "type": "string",
            "maxLength": 32767
          },
          "__workbook_marker": {
            "$ref": "#/$defs/uuid"
          },
          "__line_id": {
            "$ref": "#/$defs/uuid"
          },
          "__revision_id": {
            "$ref": "#/$defs/uuid"
          },
          "__decision_id": {
            "oneOf": [
              {
                "$ref": "#/$defs/uuid"
              },
              {
                "const": ""
              }
            ]
          },
          "__service_date": {
            "type": "string",
            "format": "date"
          },
          "__school_id": {
            "$ref": "#/$defs/uuid"
          },
          "__location_id": {
            "$ref": "#/$defs/uuid"
          },
          "__ingredient_id": {
            "$ref": "#/$defs/uuid"
          },
          "__unit_id": {
            "$ref": "#/$defs/uuid"
          },
          "__exported_quantity": {
            "$ref": "#/$defs/decimal"
          },
          "__exported_reason_code": {
            "enum": [
              "PROPOSAL_ACCEPTED",
              "PLANNING_STEP_ADJUSTMENT",
              "OPERATIONAL_QUANTITY_ADJUSTMENT",
              "OTHER"
            ]
          },
          "__exported_note": {
            "type": "string",
            "maxLength": 32767
          },
          "school_display": {
            "type": "string",
            "description": "Presentation only: canonical School on first group row, blank on following rows, or School (tiếp) on a print continuation; never an identity key."
          }
        }
      }
    }
  },
  "$defs": {
    "uuid": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "decimal": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,13})(\\.[0-9]{1,6})?$"
    }
  },
  "x-atlas-layout": {
    "visibleHeaders": ["TRƯỜNG", "THÀNH PHẦN", "ĐVT", "SỐ LƯỢNG", "GHI CHÚ"],
    "hiddenHeaders": [
      "__workbook_marker",
      "__line_id",
      "__revision_id",
      "__decision_id",
      "__service_date",
      "__school_id",
      "__location_id",
      "__ingredient_id",
      "__unit_id",
      "__exported_quantity",
      "__exported_reason_code",
      "__exported_note"
    ],
    "headerRow": 3,
    "firstDataRow": 4,
    "lastColumn": "Q",
    "editableColumns": ["D", "E"],
    "metadataSheet": "_ATLAS_META",
    "metadataState": "veryHidden",
    "paper": "A4",
    "orientation": "portrait",
    "printAreaColumns": "A:E",
    "printTitleRows": "1:3",
    "font": "Times New Roman",
    "colorSemantics": false,
    "maxPeriodDaysInclusive": 7,
    "scope": "one complete existing Confirmed Need batch",
    "tableNamePattern": "^AtlasNeed_[0-9]{8}$",
    "sheetNamePattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
    "protectionPassword": "ATLAS_SHOPPING_LIST_V1",
    "protectedSort": false,
    "partialImport": false,
    "importWrites": false,
    "legacyAccepted": false
  },
  "x-atlas-invariants": [
    "Unique __line_id; exact complete current backend line set; no name aggregation.",
    "Each row marker equals metadata workbook_marker and trusted export instance.",
    "Ordered period span is at most 7 inclusive days; row date is in period and matches containing date worksheet and canonical line.",
    "Batch/version/run/snapshot/revision/decision and School/location/Ingredient/Unit bindings match current authorized evidence.",
    "Blank visible School cells and print-only (tiếp) labels never drive identity; every row carries its own School/location/Ingredient/Unit IDs.",
    "Visible labels match trusted canonical export presentation; line identity remains unambiguous per date.",
    "Retained export manifest required for quantity edits; coupled local quantity/reason/note conflicts validated; manifest-lost recovery is annotation-only with unchanged saved quantities/reason codes.",
    "Quantity equality is exact; only real edits apply two-decimal and current Planning-step rules.",
    "A4 portrait black-and-white staff surface; repeated date/header rows, controlled School breaks, bounded print area and used range.",
    "Exact physical Table/meta/sheet set, no nonempty out-of-region cells, no formulas/executable parts.",
    "No partial apply, no import-time business write, no released-state import."
  ],
  "x-atlas-resource-limits": {
    "compressedBytes": 10485760,
    "zipEntries": 128,
    "totalUncompressedBytes": 52428800,
    "xmlPartBytes": 20971520,
    "dataLines": 10000,
    "dateSheets": 7,
    "maximumLargeEntryRatio": 200,
    "largeEntryThresholdBytes": 1048576
  }
}
