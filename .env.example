# Local Atlas environment only. Hosted staging values belong in the protected
# GitHub Environment named `atlas-staging`, never in this repository. Copy this
# file to .env.local and replace the placeholder with the
# browser-safe ANON_KEY (or PUBLISHABLE_KEY alias) printed by the repository's
# pinned `pnpm exec supabase status -o env` command. Never put SERVICE_ROLE_KEY,
# SECRET_KEY, or another privileged credential in a VITE_ variable.
VITE_ATLAS_ENVIRONMENT=local
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=replace-with-local-publishable-key

# Protected `atlas-staging` variable names (values are configured externally):
# ATLAS_STAGING_PROJECT_REF
# VITE_ATLAS_ENVIRONMENT
# VITE_SUPABASE_URL
# VITE_SUPABASE_PUBLISHABLE_KEY
# ATLAS_STAGING_TEST_EMAIL
# Protected secret names:
# ATLAS_STAGING_SUPABASE_ACCESS_TOKEN
# ATLAS_STAGING_DB_PASSWORD
# ATLAS_STAGING_TEST_PASSWORD
