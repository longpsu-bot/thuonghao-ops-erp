{
  "name": "thuonghao-ops-erp",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=24.0.0 <25",
    "pnpm": ">=11.0.0 <12"
  },
  "scripts": {
    "dev": "vite",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "ops:workspace": "node scripts/check-workspace.mjs",
    "local:auth:provision": "node scripts/provision-local-atlas-identity.mjs",
    "local:connection:verify": "node scripts/verify-local-supabase-connection.mjs",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "format": "prettier --check package.json tsconfig.json vite.config.ts index.html src .storybook STAFF_REVIEW.md docs/open-questions/planner-prototype-findings.md docs/implementation-tasks/TASK-PA-06B-local-supabase-connection-foundation.md scripts/local-supabase-status.mjs scripts/local-supabase-status.test.mjs scripts/provision-local-atlas-identity.mjs scripts/verify-local-supabase-connection.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.110.7",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@storybook/react-vite": "^10.5.0",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "jsdom": "29.1.1",
    "prettier": "3.9.5",
    "storybook": "^10.5.0",
    "supabase": "2.109.1",
    "typescript": "7.0.2",
    "vite": "8.1.4",
    "vitest": "4.1.10"
  }
}
